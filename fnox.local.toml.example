# Template for the gitignored fnox.local.toml. Keep the real file in the main
# clone, and run `mise run worktree:link-secrets` in each worktree to link to it,
# so one `fnox sync` fills the cache for every worktree.
# See docs/dev/environment-variables.md.
#
#   cp fnox.local.toml.example fnox.local.toml
#
# Provider docs: https://fnox.jdx.dev/providers/1password.html

[providers.langsmith]
type = "1password"
vault = "<your-1password-vault>"

# `fnox sync --provider sync-age --local-file` appends the encrypted cache below.
