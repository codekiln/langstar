#!/usr/bin/env bash
#MISE description="Run the pre-commit chain: fmt, check, clippy, tests, then fmt --check (stops at the first failure)"
set -euo pipefail

# Sequential on purpose: `depends` runs sibling tasks in parallel, which would
# let `cargo fmt` rewrite sources while check and clippy read them.
# rust:test wraps `fnox exec`, so a missing LangSmith secret fails the run
# before any test starts instead of skipping integration tests (#660).
mise run rust:fmt
mise run rust:check
mise run rust:clippy
mise run rust:test
cargo fmt --check
