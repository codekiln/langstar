#!/usr/bin/env bash
set -euo pipefail

#MISE description="Link this worktree's fnox.local.toml to the main clone's shared fnox secret cache"

#USAGE flag "--check" help="Report the link state and exit 1 if it is missing, without changing anything"

# fnox lets a worktree's committed fnox.toml override the same secrets in the
# main clone's fnox.local.toml, cache included, so the worktree needs its own
# fnox.local.toml. A symlink to the main clone's file lets one
# `fnox sync --provider sync-age --local-file` serve every worktree.
# See docs/dev/environment-variables.md#per-checkout-setup.

worktree_root="$(git rev-parse --show-toplevel)"
main_root="$(cd "$(git rev-parse --path-format=absolute --git-common-dir)/.." && pwd -P)"
worktree_root="$(cd "$worktree_root" && pwd -P)"

link="$worktree_root/fnox.local.toml"
target="$main_root/fnox.local.toml"

if [ "$worktree_root" = "$main_root" ]; then
  echo "This is the main clone; its fnox.local.toml is the shared cache, so there is nothing to link."
  exit 0
fi

# A relative link keeps working if the whole clone moves.
relative_target="$(perl -MFile::Spec -e 'print File::Spec->abs2rel($ARGV[0], $ARGV[1])' "$target" "$worktree_root")"

if [ -L "$link" ]; then
  current="$(readlink "$link")"
  if [ "$current" = "$relative_target" ] || [ "$current" = "$target" ]; then
    echo "fnox.local.toml already links to $relative_target"
    exit 0
  fi
  echo "error: fnox.local.toml is a symlink to $current, not $relative_target. Remove it and run again." >&2
  exit 1
fi

if [ -e "$link" ]; then
  echo "error: fnox.local.toml is a real file in this worktree. Refusing to overwrite it." >&2
  echo "Move it aside, or merge its contents into $target, then run again." >&2
  exit 1
fi

if [ "${usage_check:-false}" = "true" ]; then
  echo "fnox.local.toml is not linked. Run: mise run worktree:link-secrets" >&2
  exit 1
fi

ln -s "$relative_target" "$link"
echo "Linked fnox.local.toml -> $relative_target"

if [ ! -e "$target" ]; then
  echo "warning: $target does not exist yet. In the main clone, copy fnox.local.toml.example to fnox.local.toml, set the vault, and run: fnox sync --provider sync-age --local-file" >&2
fi
