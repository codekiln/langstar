  "AddRunToQueueRequest": {
    "properties": {
      "run_id": {
        "type": "string",
        "format": "uuid",
        "title": "Run Id"
      },
      "source_proposed_example_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ],
        "title": "Source Proposed Example Id"
      }
    },
    "type": "object",
    "required": [
      "run_id"
    ],
    "title": "AddRunToQueueRequest",
    "description": "Add a single run to AQ (CH path) with an optional back-pointer to the\nissues-agent proposal that seeded this add. Use when bulk-adding runs\nthat come from different proposals — each row carries its own\nsource_proposed_example_id. For unrelated bulk adds, prefer plain\nList[UUID] on the same endpoint."
  },
